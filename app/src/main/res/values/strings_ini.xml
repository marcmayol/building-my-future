    <string name="ini_set_help">Help: how the app works</string>
    <string name="ini_set_your_data">YOUR DATA</string>
    <string name="ini_set_your_data_body">The app only stores what it really uses. Each item says what it\'s for.</string>
    <string name="ini_set_weight">Weight</string>
    <string name="ini_set_weight_body">Used to estimate the calories of each workout, which Google Health needs to count it towards your goals.</string>
    <string name="ini_set_gender">Gender</string>
    <string name="ini_set_gender_body">Choose whether the exercise illustrations show a man or a woman. It\'s not used in any calculation.</string>
    <string name="ini_gender_male">Man</string>
    <string name="ini_gender_female">Woman</string>
    <string name="ini_gender_other">Other</string>
    <string name="ini_set_watch">I use a watch or HR monitor</string>
    <string name="ini_set_watch_body">If you start or control the workout from your watch, this applies on its own: Google Health uses the real calories from your heart rate and the app doesn\'t estimate (no double counting). Turn it on here to force it for workouts you start from your phone too.</string>
    <string name="ini_set_theme">Theme</string>
    <string name="ini_set_theme_body">How the app looks. By default it follows your phone, but you can set it to light or dark.</string>
    <string name="ini_set_how">How it works</string>
    <string name="ini_set_how_body">The first-time tour: what the app does and where everything is. You can watch it again whenever you like.</string>
